#!/bin/bash
# Pull from and push to repos in incus-spawn instances,
# rebasing commits as necessary to sign them.
# Also creates PRs using git-pr.
# See https://github.com/Sanne/incus-spawn/

source $(readlink -f ${BASH_SOURCE[0]} | xargs dirname)/lib/common.sh

function usage() {
	log 'Usage:'
	log -e '\tgit isx get [<name>]'
	log -e 'OR'
	log -e '\tgit isx put [<name>]'
	log -e 'OR'
	log -e '\tgit isx pr [<name>]'
	log ''
	log 'If <name> is not provided, uses the current branch name.'
	abort
}

function get_git_directory_name() {
	basename "$(git rev-parse --show-toplevel)"
}

function run_on_isx_remote() {
	local REMOTE_NAME="$1"
	local BASH_CMD="$2"

	local REMOTE_URL
	REMOTE_URL=$(git remote get-url "$REMOTE_NAME")

	local ISX_PART="${REMOTE_URL#isx://}"
	local INSTANCE="${ISX_PART%%/*}"
	local REPO_PATH="${ISX_PART#*/}"
	# Mirror GitRemoteUtils.expandContainerTilde: ~/... -> /home/agentuser/...
	REPO_PATH="${REPO_PATH/#~//home/agentuser}"

	incus exec "$INSTANCE" --user 1000 --cwd "/home/agentuser" -- bash -c "cd $REPO_PATH && $BASH_CMD"
}

function push_to_isx_remote() {
	local REMOTE_NAME="$1"
	local REMOTE_BRANCH="$2"

	local LOCAL_SHA
	LOCAL_SHA=$(git rev-parse HEAD)
	local REMOTE_SHA
	REMOTE_SHA=$(git rev-parse "$REMOTE_NAME/$REMOTE_BRANCH" 2>/dev/null || echo "")

	if [ "$LOCAL_SHA" != "$REMOTE_SHA" ]
	then
		log "Pushing to '$REMOTE_NAME/$REMOTE_BRANCH'..."
		git push --force "$REMOTE_NAME" "HEAD:refs/isx/incoming" \
			|| abort "Error pushing to '$REMOTE_NAME'."

		log "Resetting '$REMOTE_NAME' working tree to '$REMOTE_BRANCH'..."
		run_on_isx_remote "$REMOTE_NAME" "git reset --hard refs/isx/incoming" \
			|| abort "Error resetting working tree on '$REMOTE_NAME'."
	else
		log "Remote '$REMOTE_NAME/$REMOTE_BRANCH' is already up to date, skipping push."
	fi
}

function get_remote_checked_out_branch() {
	local REMOTE_NAME="$1"
	local BRANCH
	BRANCH=$(run_on_isx_remote "$REMOTE_NAME" "git symbolic-ref --short HEAD") \
		|| abort "Could not determine the checked-out branch on '$REMOTE_NAME'. Is the instance in detached HEAD state?"

	local REMOTE_STATUS
	REMOTE_STATUS=$(run_on_isx_remote "$REMOTE_NAME" "git status --porcelain") \
		|| abort "Error checking working tree status on '$REMOTE_NAME'."
	if [ -n "$REMOTE_STATUS" ]
	then
		log "Remote '$REMOTE_NAME' has staged/unstaged changes:"
		log "$REMOTE_STATUS"
		abort "Refusing to proceed to avoid losing uncommitted work. Commit or discard changes on the instance first."
	fi

	echo "$BRANCH"
}

function resolve_remote_name() {
	local NAME="$1"
	local GIT_DIR_NAME="$2"

	if git remote get-url "$NAME" >/dev/null 2>&1
	then
		echo "$NAME"
	elif git remote get-url "$GIT_DIR_NAME-$NAME" >/dev/null 2>&1
	then
		echo "$GIT_DIR_NAME-$NAME"
	else
		abort "No remote found for '$NAME' (tried '$NAME' and '$GIT_DIR_NAME-$NAME'). Maybe the incus-spawn instance doesn't exist?"
	fi
}

function get_branch() {
	local NAME="$1"
	local BRANCH_NAME="$2"

	local GIT_DIR_NAME
	GIT_DIR_NAME="$(get_git_directory_name)"

	local REMOTE_NAME
	REMOTE_NAME="$(resolve_remote_name "$NAME" "$GIT_DIR_NAME")"

	# Fetch the remote
	log "Fetching remote '$REMOTE_NAME'..."
	git fetch -p "$REMOTE_NAME"

	local REMOTE_BRANCH
	REMOTE_BRANCH="$(get_remote_checked_out_branch "$REMOTE_NAME")"

	if git rev-parse --quiet --verify "refs/heads/$BRANCH_NAME" >/dev/null 2>&1
	then
		# Branch exists - checkout and rebase
		log "Branch '$BRANCH_NAME' exists locally, checking out and rebasing..."

		git switch "$BRANCH_NAME" \
			|| abort "Error while checking out branch '$BRANCH_NAME'."

		# Reset to the remote's checked-out branch
		log "Resetting to '$REMOTE_NAME/$REMOTE_BRANCH'..."
		git reset --hard "$REMOTE_NAME/$REMOTE_BRANCH" \
			|| abort "Error resetting to '$REMOTE_NAME/$REMOTE_BRANCH'."

		git rebase-upstream \
			|| abort "Error during rebase. Please resolve conflicts and complete the rebase manually."

	else
		# Branch doesn't exist - create from the remote's checked-out branch
		log "Branch '$BRANCH_NAME' doesn't exist locally, creating from '$REMOTE_NAME/$REMOTE_BRANCH'..."

		# Create branch from the remote's checked-out branch without setting up tracking
		git switch -c "$BRANCH_NAME" --no-track "$REMOTE_NAME/$REMOTE_BRANCH" \
			|| abort "Error while creating branch '$BRANCH_NAME' from '$REMOTE_NAME/$REMOTE_BRANCH'."

		git rebase-upstream \
			|| abort "Error during rebase. Please resolve conflicts and complete the rebase manually."
	fi

	# Push the result back to the source remote if there are changes
	push_to_isx_remote "$REMOTE_NAME" "$REMOTE_BRANCH"

	log "Successfully checked out and rebased branch '$BRANCH_NAME'."
}

function put_branch() {
	local NAME="$1"
	local BRANCH_NAME="$2"

	local GIT_DIR_NAME
	GIT_DIR_NAME="$(get_git_directory_name)"

	local REMOTE_NAME
	REMOTE_NAME="$(resolve_remote_name "$NAME" "$GIT_DIR_NAME")"

	# Fetch the remote to ensure we have the latest state
	log "Fetching remote '$REMOTE_NAME'..."
	git fetch -p "$REMOTE_NAME"

	local REMOTE_BRANCH
	REMOTE_BRANCH="$(get_remote_checked_out_branch "$REMOTE_NAME")"

	push_to_isx_remote "$REMOTE_NAME" "$REMOTE_BRANCH"

	log "Successfully pushed branch '$BRANCH_NAME'."
}

# Main script logic
if [ "$1" == 'get' ]
then
	shift
	(( $# <= 1 )) || usage

	if [ -n "$1" ]
	then
		NAME="$1"
		BRANCH_NAME="$1"
	else
		# Use current branch name
		BRANCH_NAME=$(git symbolic-ref --short HEAD)
		NAME="$BRANCH_NAME"
	fi

	get_branch "$NAME" "$BRANCH_NAME"
elif [ "$1" == 'put' ]
then
	shift
	(( $# <= 1 )) || usage

	if [ -n "$1" ]
	then
		NAME="$1"
		BRANCH_NAME="$1"
	else
		# Use current branch name
		BRANCH_NAME=$(git symbolic-ref --short HEAD)
		NAME="$BRANCH_NAME"
	fi

	put_branch "$NAME" "$BRANCH_NAME"
elif [ "$1" == 'pr' ]
then
	shift
	(( $# <= 1 )) || usage

	if [ -n "$1" ]
	then
		NAME="$1"
		BRANCH_NAME="$1"
	else
		# Use current branch name
		BRANCH_NAME=$(git symbolic-ref --short HEAD)
		NAME="$BRANCH_NAME"
	fi

	get_branch "$NAME" "$BRANCH_NAME"

	# Check if the branch has a remote-tracking branch set up
	if ! git rev-parse --abbrev-ref --symbolic-full-name @{u} >/dev/null 2>&1
	then
		log "Initializing fork branch (setting up remote tracking)..."
		git fork branch init \
			|| abort "Error initializing fork branch."
	else
		# Remote tracking already set up, just force push
		FORK_REMOTE="$(git fork get remote)"
		log "Force pushing to fork remote '$FORK_REMOTE'..."
		git push -f "$FORK_REMOTE" "refs/heads/$BRANCH_NAME:refs/heads/$BRANCH_NAME" \
			|| abort "Error force pushing to fork remote."
	fi

	log "Creating pull request..."
	git pr create \
		|| abort "Error creating pull request."
else
	usage
fi
