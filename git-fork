#!/bin/bash
# Various utilities around GitHub forks

source $(readlink -f ${BASH_SOURCE[0]} | xargs dirname)/lib/common.sh

function usage() {
	log "Usage:"
	log -e "\tgit fork setup <upstream-remote> <fork-remote>"
	log -e "OR"
	log -e "\tgit fork purge"
	log -e "OR"
	log -e "\tgit fork get upstream.remote"
	log -e "OR"
	log -e "\tgit fork get upstream.url.http"
	log -e "OR"
	log -e "\tgit fork get upstream.branch.head.relative"
	log -e "OR"
	log -e "\tgit fork get upstream.repository.name"
	log -e "OR"
	log -e "\tgit fork get remote"
	log -e "OR"
	log -e "\tgit fork get url.http"
	log -e "OR"
	log -e "\tgit fork get user.name"
	log -e "OR"
	log -e "\tgit fork branch init"
	log -e "OR"
	log -e "\tgit fork detect-base <revision>"
	abort
}

function convert_legacy() {
	LEGACY_VALUE=$(git config --local "$1") \
		&& log "Moving legacy configuration option '$1' to '$2'..." \
		&& git config --local "$2" "$LEGACY_VALUE" \
		&& git config --local --unset "$1" \
		&& echo "$LEGACY_VALUE"
}

function setup() {
	(( $# == 2 )) && [ -n "$1" -a -n "$2" ] || usage
	git config --local fork.upstream.remote "$1"
	git config --local fork.remote "$2"
}

function autosetup() {
	
	LEGACY_VALUE=$(git config --local "$1") \
		&& log "Moving legacy configuration option '$1' to '$2'..." \
		&& git config --local "$2" "$LEGACY_VALUE" \
		&& git config --local --unset "$1" \
		&& echo "$LEGACY_VALUE"
}

function git_url_to_http() {
	sed -r 's,^(git@([^:]+):|https://([^/]+)/?)(.*)\.git$,https://\2\3/\4,'
}

# Outputs tab-separated candidates for the base branch of a revision:
#   name<TAB>commit_count<TAB>reason
# Sorted by quality: suffix matches first (strong hint from branch naming
# convention), then by commit count ascending, default branch before others
# within ties, then by merge-base recency.
function compute_base_candidates() {
	local REVISION="$1"

	local DEFAULT_BRANCH=""
	DEFAULT_BRANCH=$(git rev-parse --abbrev-ref "$UPSTREAM_REMOTE/HEAD" 2>/dev/null \
		| sed "s,^$UPSTREAM_REMOTE/,,") || true

	local -a ALL_NAMES=()
	while IFS= read -r refname; do
		local name="${refname#refs/remotes/$UPSTREAM_REMOTE/}"
		[ "$name" != "HEAD" ] || continue
		ALL_NAMES+=("$name")
	done < <(git for-each-ref --format='%(refname)' "refs/remotes/$UPSTREAM_REMOTE/")

	(( ${#ALL_NAMES[@]} > 0 )) || return 0

	local BRANCH_NAME
	BRANCH_NAME=$(git rev-parse --abbrev-ref "$REVISION" 2>/dev/null || echo "$REVISION")

	for name in "${ALL_NAMES[@]}"; do
		local ref="$UPSTREAM_REMOTE/$name"
		local mb bc ts

		mb=$(git merge-base "$REVISION" "$ref" 2>/dev/null) || continue
		bc=$(git rev-list --count "$mb..$REVISION")
		(( bc > 0 )) || continue
		ts=$(git log -1 --format='%ct' "$mb")

		local sf=0
		if [[ "$BRANCH_NAME" == *"-$name" ]] || [[ "$BRANCH_NAME" == *"/$name" ]]; then
			sf=1
		fi

		local pri subpri reason
		if (( sf == 1 )); then
			pri=0; subpri=0; reason="suffix"
		else
			pri=1; reason="merge-base"
			if [ "$name" = "$DEFAULT_BRANCH" ]; then
				subpri=0
			else
				subpri=1
			fi
		fi

		printf '%d\t%d\t%d\t%d\t%s\t%d\t%s\n' "$pri" "$bc" "$subpri" "$(( 0 - ts ))" "$name" "$bc" "$reason"
	done | sort -t$'\t' -k1,1n -k2,2n -k3,3n -k4,4n | cut -f5-7
}


if [ "$1" = 'setup' ]
then
	shift
	setup "${@}"
	success "Successfully set the upstream remote ('$1') and the fork remote ('$2')."
elif [ "$1" = 'purge' ]
then
	shift
	(( $# == 0 )) || usage
	git config --local --unset fork.upstream.remote || true
	git config --local --unset fork.remote || true
	git config --local --unset sync.fork.remote || true
	git config --local --unset sync.fork.upstream.remote || true
	success "Successfully removed all configuration for 'git-fork'."
fi

UPSTREAM_REMOTE=$(git config --local fork.upstream.remote \
	|| convert_legacy sync.fork.upstream.remote fork.upstream.remote \
	|| true)
FORK_REMOTE=$(git config --local fork.remote \
	|| convert_legacy sync.fork.remote fork.remote \
	|| true)

if [ -z "$UPSTREAM_REMOTE" -o -z "$FORK_REMOTE" ]
then
	if git remote | grep -E '^origin$' 1>/dev/null 2>&1 \
		&& git remote | grep -E '^upstream$' 1>/dev/null 2>&1
	then
		UPSTREAM_REMOTE=upstream
		FORK_REMOTE=origin
		log "Automatically setting up the upstream remote ('$UPSTREAM_REMOTE') and the fork remote ('$FORK_REMOTE')."
		setup "$UPSTREAM_REMOTE" "$FORK_REMOTE"
	elif git remote | grep -E '^origin$' 1>/dev/null 2>&1
	then
		ORIGIN_URL=$(git remote get-url origin)
		if [[ "$ORIGIN_URL" =~ github\.com[:/]([^/]+)/([^/.]+)(\.git)?/?$ ]]
		then
			REPO_OWNER="${BASH_REMATCH[1]}"
			REPO_NAME="${BASH_REMATCH[2]}"
			REPO_INFO=$(gh api "repos/$REPO_OWNER/$REPO_NAME" 2>/dev/null || true)
			if [ -n "$REPO_INFO" ] && echo "$REPO_INFO" | jq -e '.fork' >/dev/null 2>&1
			then
				if [[ "$ORIGIN_URL" =~ ^git@ ]]
				then
					PARENT_URL=$(echo "$REPO_INFO" | jq -r '.parent.ssh_url')
				else
					PARENT_URL=$(echo "$REPO_INFO" | jq -r '.parent.clone_url')
				fi
				PARENT_URL_LOWER=$(echo "$PARENT_URL" | tr '[:upper:]' '[:lower:]')
				EXISTING_UPSTREAM=""
				for _remote in $(git remote); do
					_url=$(git remote get-url "$_remote")
					if [ "$(echo "$_url" | tr '[:upper:]' '[:lower:]')" = "$PARENT_URL_LOWER" ]; then
						EXISTING_UPSTREAM="$_remote"
						break
					fi
				done
				if [ -n "$EXISTING_UPSTREAM" ]; then
					log "'origin' is a fork. Using existing remote '$EXISTING_UPSTREAM' as upstream."
					UPSTREAM_REMOTE="$EXISTING_UPSTREAM"
				else
					log "'origin' is a fork. Adding upstream remote from parent repository..."
					git remote add upstream "$PARENT_URL"
					git fetch upstream
					UPSTREAM_REMOTE=upstream
				fi
				FORK_REMOTE=origin
				log "Automatically setting up the upstream remote ('$UPSTREAM_REMOTE') and the fork remote ('$FORK_REMOTE')."
				setup "$UPSTREAM_REMOTE" "$FORK_REMOTE"
			else
				UPSTREAM_REMOTE=origin
				FORK_REMOTE=origin
				log "Automatically setting up with 'origin' as both upstream and fork remote."
				setup "$UPSTREAM_REMOTE" "$FORK_REMOTE"
			fi
		else
			abort "Cannot auto-detect fork setup for non-GitHub remotes. Use 'git fork setup <upstream-remote> <fork-remote>' first."
		fi
	else
		abort "Use 'git fork setup <upstream-remote> <fork-remote>' first."
	fi
fi


if [ "$1" = 'get' ]
then
	shift
elif [ "$1" = 'branch' ]
then
	shift
	if [ "$1" = 'init' ]
	then
		git push -u "$FORK_REMOTE" $(git rev-parse --abbrev-ref HEAD)
		success
	else
		usage
	fi
elif [ "$1" = 'detect-base' ]
then
	shift
	(( $# == 1 )) || usage
	RESULT=$(compute_base_candidates "$1")
	[ -n "$RESULT" ] \
		|| abort "No upstream branch on '$UPSTREAM_REMOTE' shares history with '$1'."
	echo "$RESULT"
	success
else
	usage
fi

if [ "$1" = 'upstream.remote' ]
then
	shift
	(( $# == 0 )) || usage
	echo "$UPSTREAM_REMOTE"
elif [ "$1" = 'upstream.url.http' ]
then
	shift
	(( $# == 0 )) || usage
	git remote get-url "$UPSTREAM_REMOTE" | git_url_to_http
elif [ "$1" = 'upstream.branch.head' ]
then
	shift
	(( $# == 0 )) || usage
	if ! UPSTREAM_HEAD=$(git rev-parse --abbrev-ref "$UPSTREAM_REMOTE/HEAD" 2>/dev/null)
	then
		# Maybe the upstream HEAD was not set yet, try to set it automatically
		git remote set-head -a "$UPSTREAM_REMOTE" 1>&2
		UPSTREAM_HEAD=$(git rev-parse --abbrev-ref "$UPSTREAM_REMOTE/HEAD")
	fi
	echo $UPSTREAM_HEAD
elif [ "$1" = 'upstream.branch.head.relative' ]
then
	shift
	(( $# == 0 )) || usage
	"$0" get 'upstream.branch.head' | sed -r "s,^$UPSTREAM_REMOTE/,,"
elif [ "$1" = 'upstream.repository.name' ]
then
	shift
	(( $# == 0 )) || usage
	git remote get-url "$UPSTREAM_REMOTE" | sed -r 's,^.*/(.*)\.git$,\1,'
elif [ "$1" = 'remote' ]
then
	shift
	(( $# == 0 )) || usage
	echo "$FORK_REMOTE"
elif [ "$1" = 'url.http' ]
then
	shift
	(( $# == 0 )) || usage
	git remote get-url "$FORK_REMOTE" | git_url_to_http
elif [ "$1" = 'user.name' ]
then
	shift
	(( $# == 0 )) || usage
	git remote get-url "$FORK_REMOTE" | sed -r 's,^git@[^:]+:([^/]+)/.*\.git$,\1,;s,^https://[^/]+/([^/]+)/.*$,\1,'
else
	usage
fi

